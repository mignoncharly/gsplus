// This is your Prisma schema file,
// learn more about it here: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  STAFF
}

enum ReservationStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAYMENT_INFO_REQUIRED
  VERIFICATION_BLOCKED
  VERIFIED
  PAID
  REJECTED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum LeadType {
  CONTACT
  B2B
  QUOTE
  CREATIVE
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  HANDLED
  ARCHIVED
  // Deprecated. The report asks for a simple Nouveau / En cours / Traité / Archivé, not a
  // sales pipeline. Existing rows were migrated to HANDLED and nothing writes these any
  // more; they remain because PostgreSQL cannot drop an enum value that a column's type
  // has ever carried without rewriting the type.
  WON
  LOST
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PackageVersionStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum PackageBookingMode {
  DIRECT
  CONTACT
}

enum ReservationScheduleKind {
  STANDARD_HOLD
  CUSTOM_PROPOSAL
}

model AdminUser {
  id                                String                            @id @default(cuid())
  email                             String                            @unique
  passwordHash                      String
  name                              String
  role                              AdminRole                         @default(STAFF)
  isActive                          Boolean                           @default(true)
  sessionVersion                    Int                               @default(0)
  // Invitation. The hash only: a token readable from the database would let anyone with
  // read access take over an account that has not been claimed yet.
  invitationTokenHash               String?                           @unique
  invitationExpiresAt               DateTime?
  invitedById                       String?
  activatedAt                       DateTime?
  deactivatedAt                     DateTime?
  // Two-factor. The secret is stored encrypted, never in clear.
  totpSecretEncrypted               String?
  totpConfirmedAt                   DateTime?
  lastSignInAt                      DateTime?
  createdAt                         DateTime                          @default(now())
  updatedAt                         DateTime                          @updatedAt
  invitedBy                         AdminUser?                        @relation("AdminUserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers                      AdminUser[]                       @relation("AdminUserInvitedBy")
  permissionGrants                  AdminPermissionGrant[]            @relation("AdminPermissionGrantAdmin")
  grantedPermissions                AdminPermissionGrant[]            @relation("AdminPermissionGrantGrantedBy")
  sessions                          AdminSession[]
  savedViews                        AdminSavedView[]
  revokedSessions                   AdminSession[]                    @relation("AdminSessionRevokedBy")
  recoveryCodes                     AdminRecoveryCode[]
  auditLogs                         AuditLog[]
  packageVersions                   PackageVersion[]                  @relation("PackageVersionCreatedBy")
  validatedPackageVersions          PackageVersion[]                  @relation("PackageVersionValidatedBy")
  publishedPackageVersions          PackageVersion[]                  @relation("PackageVersionPublishedBy")
  createdCatalogueBenefitVersions   CatalogueBenefitVersion[]         @relation("CatalogueBenefitVersionCreatedBy")
  validatedCatalogueBenefitVersions CatalogueBenefitVersion[]         @relation("CatalogueBenefitVersionValidatedBy")
  publishedCatalogueBenefitVersions CatalogueBenefitVersion[]         @relation("CatalogueBenefitVersionPublishedBy")
  paymentTransitions                PaymentTransition[]
  reservationTransitions            ReservationTransition[]
  verifiedPayments                  Payment[]                         @relation("PaymentVerifiedBy")
  scheduleExceptions                ScheduleException[]                @relation("ScheduleExceptionCreatedBy")
  studioSettings                    StudioSetting[]                    @relation("StudioSettingUpdatedBy")
  publishedSiteContent              SiteContent[]                      @relation("SiteContentPublishedBy")
  updatedSiteContent                SiteContent[]                      @relation("SiteContentUpdatedBy")
  publishedMessageTemplates         MessageTemplate[]                  @relation("MessageTemplatePublishedBy")
  updatedMessageTemplates           MessageTemplate[]                  @relation("MessageTemplateUpdatedBy")
  handledLeads              Lead[]                          @relation("LeadHandledBy")
  updatedMessageRules               MessageRule[]                      @relation("MessageRuleUpdatedBy")
  bookingRules                      BookingRule[]                      @relation("BookingRuleUpdatedBy")
  adminCommands                     AdminCommand[]
  financialTasks                    FinancialTask[]
  rescheduleRequestsRecorded        ReservationRescheduleRequest[]    @relation("RescheduleRequestedBy")
  rescheduleRequestsDecided         ReservationRescheduleRequest[]    @relation("RescheduleDecidedBy")
  withdrawalRequestsRecorded        ReservationWithdrawalRequest[]    @relation("WithdrawalRequestedBy")
  withdrawalRequestsDecided         ReservationWithdrawalRequest[]    @relation("WithdrawalDecidedBy")
  reservationDeliveries             ReservationDelivery[]
  imageConsentEvents                ImageConsentEvent[]
  mediaConsentUsagesPublished       MediaConsentUsage[]               @relation("MediaConsentUsagePublishedBy")
  dataRightsRequestsCreated         DataRightsRequest[]               @relation("DataRightsRequestCreatedBy")
  dataRightsRequestEvents           DataRightsRequestEvent[]
  reservationNotificationOverrides  ReservationNotificationOverride[]
}

model Customer {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  phone            String
  email            String?
  birthDate        DateTime?
  gender           String?
  discoveryChannel String?
  consentImage     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  reservations     Reservation[]

  @@index([phone])
  @@index([email])
}

model Package {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  category           String
  description        String?
  price              Int
  currency           String              @default("XAF")
  durationMin        Int?
  bookingMode        PackageBookingMode  @default(DIRECT)
  deliveryLabel      String?
  options            Json?
  legalText          String?
  legalApprovedAt    DateTime?
  version            Int                 @default(1)
  publishedVersion   Int?
  isPromo            Boolean             @default(false)
  isRange            Boolean             @default(false)
  isActive           Boolean             @default(true)
  isArchived         Boolean             @default(false)
  archivedAt         DateTime?
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reservationIntents ReservationIntent[]
  reservations       Reservation[]
  versions           PackageVersion[]

  bookingRule       BookingRule?

  @@index([isActive, isArchived, sortOrder])
}

model PackageVersion {
  id                 String                 @id @default(cuid())
  packageId          String
  version            Int
  name               String
  category           String
  taxonomyKey        String?
  englishEnabled     Boolean                @default(true)
  description        String?
  content            String?
  inclusions         Json?
  conditions         String?
  price              Int
  currency           String                 @default("XAF")
  durationMin        Int?
  bookingMode        PackageBookingMode     @default(DIRECT)
  deliveryLabel      String?
  options            Json?
  legalText          String?
  legalApprovedAt    DateTime?
  status             PackageVersionStatus   @default(DRAFT)
  effectiveAt        DateTime?
  validatedAt        DateTime?
  validatedById      String?
  publishedAt        DateTime?
  publishedById      String?
  archivedAt         DateTime?
  createdById        String?
  createdAt          DateTime               @default(now())
  package            Package                @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdBy          AdminUser?             @relation("PackageVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  validatedBy        AdminUser?             @relation("PackageVersionValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  publishedBy        AdminUser?             @relation("PackageVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  taxonomy           CatalogueTaxonomy?     @relation(fields: [taxonomyKey], references: [key], onDelete: Restrict)
  locales            PackageVersionLocale[]
  reservations       Reservation[]
  reservationIntents ReservationIntent[]

  @@unique([packageId, version])
  @@index([packageId, status, version])
  @@index([packageId, createdAt])
  @@index([createdById])
  @@index([validatedById])
  @@index([publishedById])
  @@index([taxonomyKey])
}

model CatalogueTaxonomy {
  key             String                    @id
  sortOrder       Int
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  locales         CatalogueTaxonomyLocale[]
  packageVersions PackageVersion[]
  benefits        CatalogueBenefitVersion[]

  @@unique([sortOrder])
  @@index([isActive, sortOrder])
}

model CatalogueTaxonomyLocale {
  id          String            @id @default(cuid())
  taxonomyKey String
  locale      String
  label       String
  taxonomy    CatalogueTaxonomy @relation(fields: [taxonomyKey], references: [key], onDelete: Cascade)

  @@unique([taxonomyKey, locale])
  @@index([locale])
}

model PackageVersionLocale {
  id               String         @id @default(cuid())
  packageVersionId String
  locale           String
  name             String
  description      String?
  content          String
  inclusions       Json
  conditions       String
  deliveryLabel    String
  mandatoryWording String
  options          Json?
  sourceReference  String
  approvedAt       DateTime?
  isEnabled        Boolean        @default(true)
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)

  @@unique([packageVersionId, locale])
  @@index([locale, isEnabled])
}

model CatalogueBenefit {
  id               String                    @id @default(cuid())
  code             String                    @unique
  publishedVersion Int?
  isActive         Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  versions         CatalogueBenefitVersion[]
}

model CatalogueBenefitVersion {
  id              String                          @id @default(cuid())
  benefitId       String
  version         Int
  taxonomyKey     String
  applicationMode String
  sortOrder       Int
  status          PackageVersionStatus            @default(DRAFT)
  effectiveAt     DateTime?
  validatedAt     DateTime?
  validatedById   String?
  publishedAt     DateTime?
  publishedById   String?
  archivedAt      DateTime?
  createdById     String?
  createdAt       DateTime                        @default(now())
  benefit         CatalogueBenefit                @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  taxonomy        CatalogueTaxonomy               @relation(fields: [taxonomyKey], references: [key], onDelete: Restrict)
  locales         CatalogueBenefitVersionLocale[]
  createdBy       AdminUser?                      @relation("CatalogueBenefitVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  validatedBy     AdminUser?                      @relation("CatalogueBenefitVersionValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  publishedBy     AdminUser?                      @relation("CatalogueBenefitVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([benefitId, version])
  @@index([benefitId, status, version])
  @@index([taxonomyKey, sortOrder])
}

model CatalogueBenefitVersionLocale {
  id               String                  @id @default(cuid())
  benefitVersionId String
  locale           String
  name             String
  advantage        String
  conditions       String
  applicationLabel String
  mandatoryWording String
  sourceReference  String
  approvedAt       DateTime?
  isEnabled        Boolean                 @default(true)
  benefitVersion   CatalogueBenefitVersion @relation(fields: [benefitVersionId], references: [id], onDelete: Cascade)

  @@unique([benefitVersionId, locale])
  @@index([locale, isEnabled])
}

model Reservation {
  id                    String                            @id @default(cuid())
  reference             String                            @unique
  customerId            String
  packageId             String
  packageVersionId      String
  startAt               DateTime
  endAt                 DateTime
  scheduleKind          ReservationScheduleKind           @default(STANDARD_HOLD)
  requestedStartAt      DateTime?
  requestedEndAt        DateTime?
  requestedTimeZone     String                            @default("Africa/Douala")
  scheduleConfirmedAt   DateTime?
  status                ReservationStatus                 @default(PENDING_CONFIRMATION)
  statusReason          String?
  statusChangedAt       DateTime                          @default(now())
  version               Int                               @default(1)
  expiresAt             DateTime?
  paymentChoice         String?
  notes                 String?
  extraInfo             String?
  acceptedTermsAt       DateTime?
  consentImage          Boolean                           @default(false)
  whatsappConsentAt     DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  customer              Customer                          @relation(fields: [customerId], references: [id])
  package               Package                           @relation(fields: [packageId], references: [id])
  packageVersion        PackageVersion                    @relation(fields: [packageVersionId], references: [id])
  payments              Payment[]
  transitions           ReservationTransition[]
  notifications         NotificationEvent[]
  calendarSyncLogs      CalendarSyncLog[]
  reservationIntent     ReservationIntent?
  snapshot              ReservationSnapshot?
  integrityIncidents    DataIntegrityIncident[]
  financialTasks        FinancialTask[]
  rescheduleRequests    ReservationRescheduleRequest[]
  withdrawalRequests    ReservationWithdrawalRequest[]
  deliveries            ReservationDelivery[]
  imageConsentEvents    ImageConsentEvent[]
  mediaItems            MediaItem[]
  mediaConsentUsages    MediaConsentUsage[]
  notificationOverrides ReservationNotificationOverride[]

  @@index([startAt, endAt])
  @@index([status])
  @@index([status, startAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([packageId])
  @@index([packageVersionId])
  @@index([expiresAt])
  @@index([scheduleKind, startAt, endAt])
}

model ReservationNotificationOverride {
  id                           String      @id @default(cuid())
  reservationId                String
  version                      Int
  recipientEmail               String
  recipientFingerprint         String
  previousRecipientFingerprint String
  reason                       String
  commandId                    String      @unique
  isActive                     Boolean     @default(true)
  deactivatedAt                DateTime?
  createdAt                    DateTime    @default(now())
  createdById                  String?
  reservation                  Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy                    AdminUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([reservationId, version])
  @@index([reservationId, isActive, createdAt])
  @@index([createdById, createdAt])
}

model ReservationSnapshot {
  id                         String                  @id @default(cuid())
  reservationId              String                  @unique
  firstName                  String
  locale                     String                  @default("fr")
  lastName                   String
  phoneRaw                   String
  phoneE164                  String
  email                      String?
  notificationEmail          String?
  notificationPhoneE164      String
  packageId                  String
  packageVersionId           String
  packageVersion             Int
  packageName                String
  packageContent             String?
  packageInclusions          Json?
  packageConditions          String?
  packageLegalText           String?
  packageEffectiveAt         DateTime?
  packagePublishedAt         DateTime?
  startAt                    DateTime
  endAt                      DateTime
  durationMin                Int
  amount                     Int
  currency                   String
  termsAccepted              Boolean
  termsVersion               String
  termsAcceptedAt            DateTime
  privacyAccepted            Boolean
  privacyVersion             String
  privacyAcceptedAt          DateTime
  whatsappConsent            Boolean
  whatsappConsentAt          DateTime?
  whatsappMarketingConsent   Boolean                 @default(false)
  whatsappMarketingConsentAt DateTime?
  imageConsent               Boolean
  imageAuthorizationVersion  String
  imageConsentAt             DateTime?
  source                     String
  evidence                   Json?
  scheduleKind               ReservationScheduleKind @default(STANDARD_HOLD)
  requestedStartAt           DateTime?
  requestedEndAt             DateTime?
  requestedTimeZone          String                  @default("Africa/Douala")
  createdAt                  DateTime                @default(now())
  reservation                Reservation             @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([phoneE164])
  @@index([email])
  @@index([packageId, packageVersion])
  @@index([createdAt])
}

model LegalDocumentVersion {
  id                 String              @id
  documentType       String
  version            String
  status             String              @default("PUBLISHED")
  sourceDocumentHash String
  noticeText         String
  purpose            String?
  scope              Json?
  effectiveAt        DateTime
  publishedAt        DateTime
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  imageConsentEvents ImageConsentEvent[]

  @@unique([documentType, version])
  @@index([documentType, status, effectiveAt])
}

model ImageConsentEvent {
  id                   String               @id @default(cuid())
  reservationId        String
  legalVersionId       String
  commandId            String?              @unique
  choice               String
  purpose              String
  scope                Json
  evidence             Json
  source               String
  effectiveAt          DateTime
  priorEventId         String?
  recordedById         String?
  createdAt            DateTime             @default(now())
  reservation          Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  legalVersion         LegalDocumentVersion @relation(fields: [legalVersionId], references: [id], onDelete: Restrict)
  recordedBy           AdminUser?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  mediaUsagesGranted   MediaConsentUsage[]  @relation("MediaUsageGrantEvent")
  mediaUsagesWithdrawn MediaConsentUsage[]  @relation("MediaUsageWithdrawalEvent")

  @@index([reservationId, effectiveAt, createdAt])
  @@index([legalVersionId])
  @@index([choice, effectiveAt])
  @@index([recordedById])
}

model DataRetentionPolicy {
  id                 String              @id
  category           String              @unique
  label              String
  version            String
  status             String              @default("PUBLISHED")
  triggerRule        String
  activeRule         String
  archiveRule        String
  dispositionRule    String
  backupRule         String
  automaticExecution Boolean             @default(false)
  effectiveAt        DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rightsRequests     DataRightsRequest[]

  @@index([status, effectiveAt])
}

model DataRightsRequest {
  id                        String                   @id @default(cuid())
  reference                 String                   @unique
  requestType               String
  status                    String                   @default("RECEIVED")
  requesterName             String
  requesterEmail            String?
  requesterPhone            String?
  reservationReference      String?
  requestChannel            String
  requestSummary            String
  identityStatus            String                   @default("UNVERIFIED")
  identityEvidenceReference String?
  processingRestricted      Boolean                  @default(false)
  retentionAction           String                   @default("NONE")
  responseSummary           String?
  responseEvidence          String?
  receivedAt                DateTime
  targetResponseAt          DateTime
  legalHoldUntil            DateTime?
  closedAt                  DateTime?
  version                   Int                      @default(1)
  retentionPolicyId         String
  createdById               String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  retentionPolicy           DataRetentionPolicy      @relation(fields: [retentionPolicyId], references: [id], onDelete: Restrict)
  createdBy                 AdminUser                @relation("DataRightsRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events                    DataRightsRequestEvent[]

  @@index([status, targetResponseAt])
  @@index([requestType, receivedAt])
  @@index([retentionPolicyId])
  @@index([createdById])
}

model DataRightsRequestEvent {
  id                        String            @id @default(cuid())
  requestId                 String
  commandId                 String            @unique
  eventType                 String
  fromStatus                String?
  toStatus                  String
  identityStatus            String
  identityEvidenceReference String?
  processingRestricted      Boolean
  retentionAction           String
  reason                    String
  responseEvidence          String?
  effectiveAt               DateTime
  recordedById              String
  createdAt                 DateTime          @default(now())
  request                   DataRightsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recordedBy                AdminUser         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([requestId, effectiveAt, createdAt])
  @@index([recordedById])
}

model DataIntegrityIncident {
  id              String       @id @default(cuid())
  code            String
  reservationId   String?
  dedupeKey       String       @unique
  status          String       @default("OPEN")
  occurrenceCount Int          @default(1)
  metadata        Json?
  firstSeenAt     DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())
  resolvedAt      DateTime?
  reservation     Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([code, status])
  @@index([reservationId])
  @@index([lastSeenAt])
}

model ReservationIntent {
  id                String                  @id @default(cuid())
  idempotencyKey    String                  @unique
  reference         String                  @unique
  packageId         String
  packageVersionId  String?
  startAt           DateTime
  endAt             DateTime
  scheduleKind      ReservationScheduleKind @default(STANDARD_HOLD)
  requestedStartAt  DateTime?
  requestedEndAt    DateTime?
  requestedTimeZone String                  @default("Africa/Douala")
  expiresAt         DateTime
  consumedAt        DateTime?
  reservationId     String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  package           Package                 @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageVersion    PackageVersion?         @relation(fields: [packageVersionId], references: [id], onDelete: SetNull)
  reservation       Reservation?            @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([startAt, endAt, expiresAt])
  @@index([scheduleKind, startAt, endAt, expiresAt])
  @@index([packageId])
  @@index([packageVersionId])
}

model ReservationTransition {
  id                  String      @id @default(cuid())
  reservationId       String
  fromStatus          String?
  toStatus            String
  reason              String?
  internalReason      String?
  customerReasonCode  String?
  customerReasonText  String?
  customerLocale      String?
  customerCopyVersion String?
  actorType           String      @default("SYSTEM")
  adminUserId         String?
  oldStartAt          DateTime?
  oldEndAt            DateTime?
  newStartAt          DateTime?
  newEndAt            DateTime?
  metadata            Json?
  createdAt           DateTime    @default(now())
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  adminUser           AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([adminUserId])
}

model Payment {
  id                       String              @id @default(cuid())
  reservationId            String
  /// Expected amount, frozen from the package price when the payment was created.
  amount                   Int
  /// Amount the studio actually observed on the operator statement, recorded by an
  /// administrator. Null until someone records it; never derived from `amount`.
  declaredAmount           Int?
  /// Set when this payment is judged to duplicate an earlier one, so the pair can be
  /// shown together instead of the later one simply being refused.
  duplicateOfPaymentId     String?
  method                   String
  transactionRef           String?
  transactionRefNormalized String?
  paymentPhone             String?
  status                   PaymentStatus       @default(PENDING)
  statusReason             String?
  statusChangedAt          DateTime            @default(now())
  version                  Int                 @default(1)
  verifiedAt               DateTime?
  verifiedById             String?
  refundAmount             Int?
  refundedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  reservation              Reservation         @relation(fields: [reservationId], references: [id])
  verifiedBy               AdminUser?          @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  duplicateOf              Payment?            @relation("PaymentDuplicate", fields: [duplicateOfPaymentId], references: [id], onDelete: SetNull)
  duplicates               Payment[]           @relation("PaymentDuplicate")
  transitions              PaymentTransition[]
  financialTasks           FinancialTask[]

  @@unique([method, transactionRefNormalized])
  @@index([reservationId])
  @@index([transactionRef])
  @@index([transactionRefNormalized])
  @@index([paymentPhone])
  @@index([verifiedById])
  @@index([duplicateOfPaymentId])
  @@index([status, createdAt])
}

model PaymentTransition {
  id                  String     @id @default(cuid())
  paymentId           String
  fromStatus          String?
  toStatus            String
  reason              String?
  internalReason      String?
  customerReasonCode  String?
  customerReasonText  String?
  customerLocale      String?
  customerCopyVersion String?
  actorType           String     @default("SYSTEM")
  adminUserId         String?
  metadata            Json?
  createdAt           DateTime   @default(now())
  payment             Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  adminUser           AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([adminUserId])
}

model FinancialTask {
  id                String      @id @default(cuid())
  reservationId     String
  paymentId         String
  createdById       String?
  dedupeKey         String      @unique
  type              String
  status            String      @default("PENDING")
  amount            Int
  currency          String      @default("XAF")
  reason            String
  channel           String?
  providerReference String?
  proof             Json?
  dueAt             DateTime
  initiatedAt       DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  payment           Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy         AdminUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([reservationId, createdAt])
  @@index([paymentId])
  @@index([createdById])
}

model ReservationRescheduleRequest {
  id                          String      @id @default(cuid())
  reservationId               String
  commandId                   String      @unique
  requestedById               String?
  decidedById                 String?
  status                      String      @default("PENDING")
  version                     Int         @default(1)
  reservationVersionAtRequest Int
  oldStartAt                  DateTime
  oldEndAt                    DateTime
  requestedStartAt            DateTime
  requestedEndAt              DateTime
  reason                      String
  decisionReason              String?
  internalDecisionReason      String?
  customerReasonCode          String?
  customerReasonText          String?
  customerLocale              String?
  customerCopyVersion         String?
  requestedAt                 DateTime    @default(now())
  decidedAt                   DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  reservation                 Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  requestedBy                 AdminUser?  @relation("RescheduleRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy                   AdminUser?  @relation("RescheduleDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([status, requestedAt])
  @@index([requestedById])
  @@index([decidedById])
}

model ReservationWithdrawalRequest {
  id                          String      @id @default(cuid())
  reservationId               String
  commandId                   String      @unique
  requestedById               String?
  decidedById                 String?
  status                      String      @default("PENDING")
  version                     Int         @default(1)
  reservationVersionAtRequest Int
  contractConcludedAt         DateTime
  legalDeadlineAt             DateTime
  receivedAt                  DateTime
  receivedWithinLegalWindow   Boolean
  requestChannel              String
  requestText                 String
  requestEvidence             String
  serviceStatus               String
  executionStartedAt          DateTime?
  decisionReason              String?
  internalDecisionReason      String?
  customerReasonCode          String?
  customerReasonText          String?
  customerLocale              String?
  customerCopyVersion         String?
  decidedAt                   DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  reservation                 Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  requestedBy                 AdminUser?  @relation("WithdrawalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy                   AdminUser?  @relation("WithdrawalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([status, receivedAt])
  @@index([requestedById])
  @@index([decidedById])
}

model ReservationDelivery {
  id                          String      @id @default(cuid())
  reservationId               String
  commandId                   String      @unique
  publishedById               String?
  reservationVersionAtPublish Int
  deliveryUrl                 String
  accessInstruction           String
  expiresAt                   DateTime
  status                      String      @default("AVAILABLE")
  verificationStatusCode      Int
  verifiedAt                  DateTime
  revokedAt                   DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  reservation                 Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  publishedBy                 AdminUser?  @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([status, expiresAt])
  @@index([publishedById])
}

model Lead {
  id                String              @id @default(cuid())
  reference         String              @unique
  submissionKey     String?             @unique
  type              LeadType
  status            LeadStatus          @default(NEW)
  name              String
  email             String?
  phone             String?
  company           String?
  rccm              String?
  subject           String?
  message           String
  locale            String              @default("fr")
  source            String?
  whatsappConsentAt DateTime?
  internalNote      String?
  handledAt         DateTime?
  handledById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  notifications     NotificationEvent[]
  handledBy         AdminUser?          @relation("LeadHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([createdAt])
  @@index([handledById])
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt, endAt])
}

model BusinessHour {
  id        String   @id @default(cuid())
  dayOfWeek Int
  opensAt   String
  closesAt  String
  isClosed  Boolean  @default(false)
  /// Intra-day pauses as [{ "start": "12:30", "end": "13:30" }]. Null means none.
  breaks    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}

/// A dated override of the weekly pattern: a public holiday, an exceptional closure,
/// or a day worked outside the usual hours. Takes precedence over BusinessHour.
/// One row per settings group, holding that group's JSON object. Groups are defined by
/// a typed registry in code, so the application works with no rows at all: an absent
/// group falls back to the compiled default, which is the value that was hard-coded
/// before this phase.
model StudioSetting {
  id          String     @id @default(cuid())
  group       String     @unique
  value       Json
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  updatedBy   AdminUser? @relation("StudioSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

/// Editable page copy, FAQ entries and SEO text, versioned with the same
/// draft -> published lifecycle the catalogue already uses.
model SiteContent {
  id            String     @id @default(cuid())
  key           String
  locale        String     @default("fr")
  version       Int        @default(1)
  status        String     @default("DRAFT")
  // Translation workflow applies to English drafts. The publication status above
  // remains the source of truth for what is visible to visitors.
  translationStatus        String?
  translationSourceVersion Int?
  translationError         String?
  body          Json
  publishedAt   DateTime?
  publishedById String?
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedBy   AdminUser? @relation("SiteContentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  updatedBy     AdminUser? @relation("SiteContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key, locale, version])
  @@index([key, locale, status])
  @@index([publishedById])
  @@index([updatedById])
}

/// An editable override of a code template, versioned like SiteContent.
///
/// The code registry in src/emails/templates.ts stays the source of truth: rendering
/// consults a cache of published overrides and falls back to the compiled template
/// whenever there is none, or whenever the database is unreachable. The outbox can
/// therefore never lose a template.
model MessageTemplate {
  id            String     @id @default(cuid())
  code          String
  locale        String     @default("fr")
  version       Int        @default(1)
  status        String     @default("DRAFT")
  subject       String
  preheader     String
  /// Body lines as a JSON array of strings, matching the code registry's shape.
  body          Json
  publishedAt   DateTime?
  publishedById String?
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedBy   AdminUser? @relation("MessageTemplatePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  updatedBy     AdminUser? @relation("MessageTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([code, locale, version])
  @@index([code, locale, status])
  @@index([status])
}

/// Send policy per event: delay, grouping window, attempts and fallback channel.
/// A missing row means the behaviour compiled into the notification workers.
model MessageRule {
  event                 String     @id
  delayMinutes          Int?
  groupingWindowMinutes Int?
  maxAttempts           Int?
  isEnabled             Boolean    @default(true)
  updatedById           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  updatedBy             AdminUser? @relation("MessageRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model ScheduleException {
  id          String    @id @default(cuid())
  /// Douala business day, `YYYY-MM-DD`.
  date        String    @unique
  isClosed    Boolean   @default(true)
  opensAt     String?
  closesAt    String?
  breaks      Json?
  reason      String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   AdminUser? @relation("ScheduleExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([createdById])
}

/// Booking policy. One global row (packageId null) plus optional per-package
/// overrides. A null field on a package row falls back to the global value.
model BookingRule {
  id               String    @id @default(cuid())
  packageId        String?   @unique
  minNoticeMinutes Int?
  horizonDays      Int?
  dailyCapacity    Int?
  bufferMinutes    Int?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  package          Package?  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  updatedBy        AdminUser? @relation("BookingRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model MediaItem {
  id                String              @id @default(cuid())
  title             String
  altText           String?
  url               String
  storagePath       String?
  thumbnailUrl      String?
  category          String?
  width             Int?
  height            Int?
  mimeType          String?
  fileSize          Int?
  thumbnailWidth    Int?
  thumbnailHeight   Int?
  thumbnailFileSize Int?
  objectPosition    String?
  isFeatured        Boolean             @default(false)
  isPublished       Boolean             @default(false)
  rightsBasis       String?
  rightsEvidence    Json?
  reservationId     String?
  publishedAt       DateTime?
  unpublishedAt     DateTime?
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  reservation       Reservation?        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  consentUsages     MediaConsentUsage[]

  @@index([isPublished, sortOrder])
  @@index([category])
  @@index([rightsBasis, isPublished])
  @@index([reservationId])
}

model MediaConsentUsage {
  id                String             @id @default(cuid())
  mediaItemId       String
  reservationId     String
  grantEventId      String
  withdrawalEventId String?
  status            String             @default("ACTIVE")
  purpose           String
  scope             Json
  activatedAt       DateTime           @default(now())
  deactivatedAt     DateTime?
  publishedById     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  mediaItem         MediaItem          @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  reservation       Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  grantEvent        ImageConsentEvent  @relation("MediaUsageGrantEvent", fields: [grantEventId], references: [id], onDelete: Restrict)
  withdrawalEvent   ImageConsentEvent? @relation("MediaUsageWithdrawalEvent", fields: [withdrawalEventId], references: [id], onDelete: Restrict)
  publishedBy       AdminUser?         @relation("MediaConsentUsagePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([mediaItemId, grantEventId])
  @@index([reservationId, status])
  @@index([grantEventId])
  @@index([withdrawalEventId])
  @@index([publishedById])
}

model NotificationEvent {
  id                   String                @id @default(cuid())
  reservationId        String?
  leadId               String?
  channel              String
  type                 String
  recipient            String
  idempotencyKey       String?               @unique
  providerMessageId    String?
  providerStatus       String?
  templateCode         String?
  templateVersion      String?
  renderedContent      Json?
  status               NotificationStatus    @default(PENDING)
  attemptCount         Int                   @default(0)
  maxAttempts          Int                   @default(5)
  lastAttemptAt        DateTime?
  nextAttemptAt        DateTime?
  lockedAt             DateTime?
  lastWebhookAt        DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  error                String?
  resolution           String?
  resolutionNote       String?
  resolvedAt           DateTime?
  resolvedBy           String?
  replacementEventId   String?
  metadata             Json?
  sentAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  reservation          Reservation?          @relation(fields: [reservationId], references: [id])
  lead                 Lead?                 @relation(fields: [leadId], references: [id])
  attempts             NotificationAttempt[]
  emailDeliveryReports EmailDeliveryReport[]

  @@unique([channel, providerMessageId])
  @@index([status, resolvedAt])
  @@index([reservationId])
  @@index([leadId])
  @@index([status])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
}

model EmailDeliveryReport {
  id                  String            @id @default(cuid())
  notificationEventId String
  providerEventId     String            @unique
  providerMessageId   String
  status              String
  smtpCode            String?
  safeMessage         String
  occurredAt          DateTime
  createdAt           DateTime          @default(now())
  notificationEvent   NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)

  @@index([notificationEventId, occurredAt])
  @@index([status, occurredAt])
}

model NotificationAttempt {
  id                  String            @id @default(cuid())
  notificationEventId String
  attemptNumber       Int
  channel             String
  status              String
  providerMessageId   String?
  providerStatus      String?
  error               String?
  startedAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  notificationEvent   NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)

  @@unique([notificationEventId, attemptNumber])
  @@index([providerMessageId])
  @@index([status, startedAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([entityType, entityId])
}

model AdminCommand {
  id          String     @id
  action      String
  entityType  String
  entityId    String
  requestHash String
  status      String     @default("PROCESSING")
  result      Json?
  adminUserId String?
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([status, createdAt])
}

model CalendarSyncLog {
  id                 String       @id @default(cuid())
  reservationId      String?
  provider           String       @default("cal_com")
  action             String       @default("CREATE")
  idempotencyKey     String?      @unique
  payloadHash        String?
  reservationVersion Int?
  externalEventId    String?
  providerStatus     String?
  status             String       @default("PENDING")
  attemptCount       Int          @default(0)
  maxAttempts        Int          @default(3)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?
  syncedAt           DateTime?
  lockedAt           DateTime?
  error              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  reservation        Reservation? @relation(fields: [reservationId], references: [id])

  @@index([reservationId, createdAt])
  @@index([externalEventId])
  @@index([status, nextAttemptAt, lockedAt])
}

/**
 * A permission granted to one account on top of what its role carries.
 *
 * Roles stay as the coarse default; a grant is how the owner opens one module to one
 * person without promoting them. There is no "deny" row on purpose: a permission a role
 * carries is removed by changing the role, so nobody has to reason about two directions
 * of override at once.
 */
model AdminPermissionGrant {
  id           String    @id @default(cuid())
  adminUserId  String
  permission   String
  grantedById  String?
  grantedAt    DateTime  @default(now())
  admin        AdminUser @relation("AdminPermissionGrantAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  grantedBy    AdminUser? @relation("AdminPermissionGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([adminUserId, permission])
  @@index([grantedById])
}

/**
 * A private, named filter preset. It stores no reservation data.
 */
model AdminSavedView {
  id          String    @id @default(cuid())
  adminUserId String
  scope       String
  name        String
  filters     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, scope, name])
  @@index([adminUserId, scope, updatedAt])
}


model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?
  revokedReason String?
  admin        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  revokedBy    AdminUser? @relation("AdminSessionRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
  @@index([revokedById])
}

/** Single-use codes for the day the authenticator app is gone. Hashed, never stored in clear. */
model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, usedAt])
}

/**
 * Every sign-in attempt, successful or not.
 *
 * Kept by e-mail rather than by account so an attempt against an address that does not
 * exist is recorded too — that is exactly the pattern worth seeing.
 */
model AdminSignInAttempt {
  id          String   @id @default(cuid())
  email       String
  ipAddress   String?
  userAgent   String?
  succeeded   Boolean
  failureCode String?
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}
